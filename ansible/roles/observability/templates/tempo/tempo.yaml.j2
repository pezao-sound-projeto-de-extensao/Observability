server:
  http_listen_port: 3200

distributor:
  receivers:
    otlp:
      protocols:
        http:
          endpoint: 0.0.0.0:4318

storage:
  trace:
    backend: s3
    wal:
      path: /var/tempo/wal
    s3:
      bucket: {{ buckets['tempo-traces'] }}
      endpoint: s3.{{ aws_region }}.amazonaws.com
      region: {{ aws_region }}

compactor:
  compaction:
    block_retention: 168h

metrics_generator:
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://mimir:9009/api/v1/push
        send_exemplars: true
  processor:
    span_metrics:
      filter_policies:
        - exclude:
            match_type: regex # "regular" é inválido (só strict|regex): o generator recusava todos os spans
            attributes:
              - key: name
                value: ".*/api/health.*"
    local_blocks:
      flush_to_storage: true
  traces_storage:
    path: /var/tempo/generator/traces

overrides:
  defaults:
    metrics_generator:
      processors: [service-graphs, span-metrics, local-blocks]
