name: observability

services:
  alloy:
    image: grafana/alloy:{{ alloy_version }}
    restart: unless-stopped
    mem_limit: 768m
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - --stability.level=experimental
    ports:
      - "3500:3500"
      - "4317:4317"
      - "4318:4318"
      - "4040:4040"
      - "9999:9999"
      - "12347:12347"
      - "12345:12345"
    volumes:
      - ./alloy:/etc/alloy:ro
      - alloy-data:/var/lib/alloy/data
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro

  cloudwatch-reader:
    image: cloudwatch-reader:local
    restart: unless-stopped
    mem_limit: 256m
    volumes:
      - ./cloudwatch-reader/config:/etc/cloudwatch-reader:ro
      - cloudwatch-reader-data:/var/lib/cloudwatch-reader

  loki:
    image: grafana/loki:{{ loki_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -config.file=/etc/loki/loki.yaml
    volumes:
      - ./loki:/etc/loki:ro
      - loki-data:/loki

  tempo:
    image: grafana/tempo:{{ tempo_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -target=all
      - -config.file=/etc/tempo/tempo.yaml
    volumes:
      - ./tempo:/etc/tempo:ro
      - tempo-data:/var/tempo

  mimir:
    image: grafana/mimir:{{ mimir_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -target=all
      - -config.file=/etc/mimir/mimir.yaml
    volumes:
      - ./mimir:/etc/mimir:ro
      - mimir-data:/data

  pyroscope:
    image: grafana/pyroscope:{{ pyroscope_version }}
    restart: unless-stopped
    mem_limit: 768m
    command:
      - -config.file=/etc/pyroscope/pyroscope.yaml
    volumes:
      - ./pyroscope:/etc/pyroscope:ro
      - pyroscope-data:/data

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    restart: unless-stopped
    mem_limit: 512m
    env_file: .env
    environment:
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_ROOT_URL: "{{ grafana_root_url }}"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_USERS_DEFAULT_LANGUAGE: pt-BR
      GF_USERS_DEFAULT_THEME: dark
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/provisioning/dashboards/inicio.json
      # Nenhum app embutido sem uso: Drilldown (2.5/5.3) e profiles do Pyroscope (5.1) estão todos ativos
    ports:
      - "3000:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana

  limpeza-inicio:
    image: curlimages/curl:8.11.1
    restart: unless-stopped
    mem_limit: 32m
    entrypoint: ["sh", "-c"]
    command:
      - |
        until curl -sf http://loki:3100/ready && curl -sf http://pyroscope:4040/ready; do sleep 10; done
        sleep 120
        curl -sf -X POST -G http://loki:3100/loki/api/v1/delete \
          --data-urlencode 'query={env="production"} |~ "OTel export failure|Error uploading snapshot: 422"' \
          --data-urlencode "start=$$(( $$(date +%s) - 3600 ))" || exit 1
        exec sleep infinity

volumes:
  alloy-data:
  cloudwatch-reader-data:
  loki-data:
  tempo-data:
  mimir-data:
  pyroscope-data:
  grafana-data:
