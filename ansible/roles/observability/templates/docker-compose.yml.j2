name: observability

services:
  alloy:
    image: grafana/alloy:{{ alloy_version }}
    restart: unless-stopped
    mem_limit: 768m
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - --stability.level=experimental
    ports:
      - "3500:3500"
      - "4318:4318"
      - "4040:4040"
      - "9999:9999"
      - "12347:12347"
      - "12345:12345"
    volumes:
      # Diretório, não arquivo: o Ansible troca o inode e o /-/reload veria a config antiga
      - ./alloy:/etc/alloy:ro
      - alloy-data:/var/lib/alloy/data
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro

  # Imagem gerada pelo Ansible com docker build: o Docker do dnf não traz o buildx, exigido pelo build do Compose
  cloudwatch-reader:
    image: cloudwatch-reader:local
    restart: unless-stopped
    mem_limit: 256m
    volumes:
      - ./cloudwatch-reader/config:/etc/cloudwatch-reader:ro
      - cloudwatch-reader-data:/var/lib/cloudwatch-reader

  loki:
    image: grafana/loki:{{ loki_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -config.file=/etc/loki/loki.yaml
    volumes:
      - ./loki:/etc/loki:ro
      - loki-data:/loki

  tempo:
    image: grafana/tempo:{{ tempo_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -target=all
      - -config.file=/etc/tempo/tempo.yaml
    volumes:
      - ./tempo:/etc/tempo:ro
      - tempo-data:/var/tempo
      - tempo-generator:/var/tempo/generator

  mimir:
    image: grafana/mimir:{{ mimir_version }}
    restart: unless-stopped
    mem_limit: 1g
    command:
      - -target=all
      - -config.file=/etc/mimir/mimir.yaml
    volumes:
      - ./mimir:/etc/mimir:ro
      - mimir-data:/data

  pyroscope:
    image: grafana/pyroscope:{{ pyroscope_version }}
    restart: unless-stopped
    mem_limit: 768m
    command:
      - -config.file=/etc/pyroscope/pyroscope.yaml
    volumes:
      - ./pyroscope:/etc/pyroscope:ro
      - pyroscope-data:/data

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    restart: unless-stopped
    mem_limit: 512m # 256m não basta: o Grafana 13.3 sofre OOM ao carregar os plugins na subida
    env_file: .env
    environment:
      GF_USERS_ALLOW_SIGN_UP: "false"
      # Servido em /grafana na porta 80 do ALB. O Live (WebSocket) confere a origem pelo root_url
      GF_SERVER_ROOT_URL: "{{ grafana_root_url }}"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_USERS_DEFAULT_LANGUAGE: pt-BR
      GF_USERS_DEFAULT_THEME: dark
      GF_NEWS_NEWS_FEED_ENABLED: "false"
    ports:
      - "3000:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana

volumes:
  alloy-data:
  cloudwatch-reader-data:
  loki-data:
  tempo-data:
  tempo-generator:
  mimir-data:
  pyroscope-data:
  grafana-data:
