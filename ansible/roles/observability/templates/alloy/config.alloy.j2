// Containers: Fluent Bit -> Alloy. As 4 labels já chegam prontas.
loki.source.api "fluentbit" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw.receiver]
}

// RDS e WAF: o leitor do CloudWatch envia para cá, já com as 4 labels (task 2.4).
// Uma porta por origem para separar o arquivo bruto. Portas só na rede do Compose.
loki.source.api "rds" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3501
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw_rds.receiver]
}

loki.source.api "waf" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3502
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw_waf.receiver]
}

// Nível para as linhas sem campo level (nginx, WAF, RDS e texto do app), senão o Grafana mostra "unknown".
// Vai como structured metadata, não label (cardinalidade). Os match seguintes sobrescrevem o anterior.
loki.process "level" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector = `{service=~"nginx|waf|rds|web"}`
    stage.template {
      source   = "level"
      template = "INFO"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":"`
    stage.template {
      source   = "level"
      template = "INFO"
    }
  }
  stage.match {
    selector = `{service="nginx"} |~ "\"status\":4[0-9][0-9]"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="nginx"} |~ "\"status\":5[0-9][0-9]"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="web"} |~ "HTTP/[0-9.]+.{1,2} 4[0-9][0-9] "`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="web"} |~ "HTTP/[0-9.]+.{1,2} 5[0-9][0-9] "`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="web"} |= "[warn]"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="web"} |~ "\\[(error|crit|alert|emerg)\\]"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="waf"} |= "\"action\":\"BLOCK\""`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="rds"} |= "[Warning]"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="rds"} |= "[ERROR]"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":" |~ "WARN"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":" |~ "Exception|Error|ERROR"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }

  stage.structured_metadata {
    values = { level = "" }
  }
}

faro.receiver "frontend" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    max_allowed_payload_size = "1MiB"
    rate_limiting {
      rate       = 50
      burst_size = 100
    }
  }
  output {
    logs   = [loki.process.faro.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

loki.process "faro" {
  stage.static_labels {
    values = {
      env     = "production",
      origin  = "frontend",
      service = "frontend",
    }
  }
  stage.label_keep {
    values = ["env", "origin", "service"]
  }
  forward_to = [loki.write.default.receiver]
}

pyroscope.receive_http "backends" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 4040
  }
  forward_to = [pyroscope.write.default.receiver]
}

pyroscope.write "default" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}

loki.write "default" {
  endpoint {
    url                 = "http://loki:3100/loki/api/v1/push"
    max_backoff_retries = 0 // tenta indefinidamente enquanto o Loki reinicia
  }
}

otelcol.receiver.loki "raw" {
  output {
    logs = [otelcol.processor.batch.raw_containers.input]
  }
}

otelcol.receiver.loki "raw_rds" {
  output {
    logs = [otelcol.processor.batch.raw_rds.input]
  }
}

otelcol.receiver.loki "raw_waf" {
  output {
    logs = [otelcol.processor.batch.raw_waf.input]
  }
}

// Arquivo bruto. O batch evita um objeto no S3 a cada push e fica fora do caminho do Live Tail.
otelcol.processor.batch "raw_containers" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.containers.input]
  }
}

otelcol.processor.batch "raw_rds" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.rds.input]
  }
}

otelcol.processor.batch "raw_waf" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.waf.input]
  }
}

otelcol.exporter.awss3 "containers" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=container-logs"
  }
  marshaler {
    type = "body"
  }
}

otelcol.exporter.awss3 "rds" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=rds-logs"
  }
  marshaler {
    type = "body"
  }
}

otelcol.exporter.awss3 "waf" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=waf-logs"
  }
  marshaler {
    type = "body"
  }
}

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.healthcheck.input]
  }
}

otelcol.processor.filter "healthcheck" {
  error_mode = "ignore"
  traces {
    span = ["attributes[\"url.path\"] == \"/api/health\""]
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
    tls {
      insecure = true
    }
  }
}

// =============================================================
// TASK 4.1 + 4.3: métricas
// =============================================================

// Recebe as métricas OTLP do agente Java e converte para Prometheus
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Liga o receiver OTLP existente às métricas (adiciona ao output do "default")
// NOTA: o receiver "default" acima só declara traces; criamos um segundo receiver
// exclusivo para métricas na porta 4318 (HTTP/proto aceita os dois sinais).
// O agente Java envia métricas e traces no mesmo endpoint; o exporter prometheus
// acima extrai só as métricas.

prometheus.remote_write "mimir" {
  endpoint {
    url            = "http://mimir:9009/api/v1/push"
    send_exemplars = true
  }
}

// Self-monitoring: métricas do próprio Alloy
prometheus.exporter.self "alloy" {}

discovery.relabel "self" {
  targets = prometheus.exporter.self.alloy.targets
  rule {
    target_label = "job"
    replacement  = "alloy"
  }
}

// Self-monitoring: métricas do host (CPU, disco, memória da EC2)
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement  = "node"
  }
}

// Scrape de todos os componentes da stack
prometheus.scrape "stack" {
  scrape_interval = "30s"
  targets = array.concat(
    discovery.relabel.self.output,
    discovery.relabel.host.output,
    [
      {"__address__" = "loki:3100",    "job" = "loki"},
      {"__address__" = "tempo:3200",   "job" = "tempo"},
      {"__address__" = "mimir:9009",   "job" = "mimir"},
      {"__address__" = "grafana:3000", "job" = "grafana"},
      // task 5.1 soma: {"__address__" = "pyroscope:4040", "job" = "pyroscope"},
    ],
  )
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Recebe as métricas do Fluent Bit (task 1.4, porta 9999)
prometheus.receive_http "fluentbit" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
