// Containers: Fluent Bit -> Alloy. As 4 labels já chegam prontas.
loki.source.api "fluentbit" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw.receiver]
}

// RDS e WAF: o leitor do CloudWatch envia para cá, já com as 4 labels (task 2.4).
// Uma porta por origem para separar o arquivo bruto. Portas só na rede do Compose.
loki.source.api "rds" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3501
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw_rds.receiver]
}

loki.source.api "waf" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3502
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.level.receiver, otelcol.receiver.loki.raw_waf.receiver]
}

// Nível para as linhas sem campo level (nginx, WAF, RDS e texto do app), senão o Grafana mostra "unknown".
// Vai como structured metadata, não label (cardinalidade). Os match seguintes sobrescrevem o anterior.
loki.process "level" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector = `{service=~"nginx|waf|rds"}`
    stage.template {
      source   = "level"
      template = "INFO"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":"`
    stage.template {
      source   = "level"
      template = "INFO"
    }
  }
  stage.match {
    selector = `{service="nginx"} |~ "\"status\":4[0-9][0-9]"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="nginx"} |~ "\"status\":5[0-9][0-9]"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="waf"} |= "\"action\":\"BLOCK\""`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="rds"} |= "[Warning]"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="rds"} |= "[ERROR]"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":" |~ "WARN"`
    stage.template {
      source   = "level"
      template = "WARN"
    }
  }
  stage.match {
    selector = `{service="app"} != "\"level\":" |~ "Exception|Error|ERROR"`
    stage.template {
      source   = "level"
      template = "ERROR"
    }
  }

  stage.structured_metadata {
    values = { level = "" }
  }
}

loki.write "default" {
  endpoint {
    url                 = "http://loki:3100/loki/api/v1/push"
    max_backoff_retries = 0 // tenta indefinidamente enquanto o Loki reinicia
  }
}

otelcol.receiver.loki "raw" {
  output {
    logs = [otelcol.processor.batch.raw_containers.input]
  }
}

otelcol.receiver.loki "raw_rds" {
  output {
    logs = [otelcol.processor.batch.raw_rds.input]
  }
}

otelcol.receiver.loki "raw_waf" {
  output {
    logs = [otelcol.processor.batch.raw_waf.input]
  }
}

// Arquivo bruto. O batch evita um objeto no S3 a cada push e fica fora do caminho do Live Tail.
otelcol.processor.batch "raw_containers" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.containers.input]
  }
}

otelcol.processor.batch "raw_rds" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.rds.input]
  }
}

otelcol.processor.batch "raw_waf" {
  timeout = "60s"
  output {
    logs = [otelcol.exporter.awss3.waf.input]
  }
}

otelcol.exporter.awss3 "containers" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=container-logs"
  }
  marshaler {
    type = "body"
  }
}

otelcol.exporter.awss3 "rds" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=rds-logs"
  }
  marshaler {
    type = "body"
  }
}

otelcol.exporter.awss3 "waf" {
  s3_uploader {
    region    = "{{ aws_region }}"
    s3_bucket = "{{ buckets['logs-raw'] }}"
    s3_prefix = "origin=waf-logs"
  }
  marshaler {
    type = "body"
  }
}
