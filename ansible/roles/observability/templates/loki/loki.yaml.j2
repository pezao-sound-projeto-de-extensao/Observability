auth_enabled: false

server:
  http_listen_port: 3100
  # O padrão de 4 MB não comporta 5.000 linhas de WAF (~1,6 KB cada): a consulta dava 504 (task 2.4)
  grpc_server_max_recv_msg_size: 16777216
  grpc_server_max_send_msg_size: 16777216

common:
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2026-10-01
      store: tsdb
      object_store: s3
      schema: v13
      index:
        prefix: index_
        period: 24h

# Sem chaves: as credenciais vêm do LabInstanceProfile
storage_config:
  tsdb_shipper:
    active_index_directory: /loki/index
    cache_location: /loki/index_cache
  aws:
    region: {{ aws_region }}
    bucketnames: {{ buckets['loki-logs'] }}

ingester:
  wal:
    dir: /loki/wal

limits_config:
  retention_period: 168h

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: s3
