      "title": "JVM — memória usada",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (jvm_memory_type) (jvm_memory_used_bytes)",
          "legendFormat": "{{jvm_memory_type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
